{
  "cli": {
    "version": ">= 5.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "http://127.0.0.1:8000",
        "EXPO_PUBLIC_BILLING": "play"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://ferryproxy.onrender.com",
        "EXPO_PUBLIC_BILLING": "play"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://ferryproxy.onrender.com",
        "EXPO_PUBLIC_BILLING": "play",
        "EXPO_PUBLIC_REVENUECAT_ANDROID_KEY": "goog_fuzEkJYnBXKEuZoJDqyQeTrFSxg"
      },
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
