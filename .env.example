# Server (server/.env)
#
# Four service-account keys, created by hand in each provider's console and held
# only here. No key ever reaches a device. Two Gemini keys because enabling
# billing on a Google Cloud project deletes its free tier, so the free and paid
# tiers must live in separate projects.
GEMINI_FREE_API_KEY=...
GEMINI_FREE_MODEL=gemini-3.6-flash
GEMINI_PAID_API_KEY=...
GEMINI_PAID_MODEL=gemini-pro-latest

OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_EFFORT=medium

# Verifies store receipts server-side. Without it every caller stays on the free
# tier, because an unverifiable receipt must never unlock a paid model.
REVENUECAT_API_KEY=

# MUST be false in production. When true the relay accepts a "dev:" receipt, so
# anyone could unlock the paid models without paying.
ALLOW_DEV_SUBSCRIPTION=true

# A store sandbox grants the same entitlement as a real purchase and takes test
# cards. MUST stay false in production, or anyone who finds the sandbox checkout
# unlocks the paid models for free.
ALLOW_SANDBOX_PURCHASES=false

# One purchase must not buy unbounded API spend.
MONTHLY_ANSWER_ALLOWANCE=300

DEFAULT_LLM_PROVIDER=anthropic
LLM_MAX_TOKENS=2048

CHUNK_SIZE_BYTES=512
CACHE_TTL_SECONDS=300

# Loss/latency simulation proxy (server/scripts/simulate_loss.py)
LOSS_PROBABILITY=0.9
LATENCY_MIN_MS=300
LATENCY_MAX_MS=2000
TARGET_URL=http://127.0.0.1:8000
PROXY_PORT=8001

# Signs the webhook the web checkout sends when someone pays. It is the only
# thing between that endpoint and free answer pools for anyone who finds the URL,
# so without it the relay refuses every webhook rather than trusting it.
LEMONSQUEEZY_WEBHOOK_SECRET=
# Where those purchases are written down. The checkout announces one once and
# cannot be asked again, so in production this must sit inside a mounted volume.
WEB_PURCHASE_STORE_PATH=.web-purchases.json

# Client (client/.env) — https in production, or the app's requests are cleartext
EXPO_PUBLIC_API_URL=http://127.0.0.1:8000

# The web checkout link, for builds Play does not distribute. The app appends the
# install's id as custom data, which is what the webhook hands back.
EXPO_PUBLIC_WEB_PURCHASE_URL=https://your-store.lemonsqueezy.com/checkout/buy/...

# RevenueCat public SDK keys, one per store. These are safe in the app; the secret
# key above lives only on the relay. Without them the app cannot sell anything and
# stays on the free tier, which is what web and Expo Go do anyway.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_...
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_...
