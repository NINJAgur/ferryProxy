# Server (server/.env) — configure at least one provider's key; only providers
# actually requested by the client need a key present.
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_EFFORT=medium

OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

GEMINI_API_KEY=...
GEMINI_MODEL=gemini-3.6-flash

DEFAULT_LLM_PROVIDER=anthropic
LLM_MAX_TOKENS=2048

CHUNK_SIZE_BYTES=512
CACHE_TTL_SECONDS=300

# Loss/latency simulation proxy (server/scripts/simulate_loss.py)
LOSS_PROBABILITY=0.9
LATENCY_MIN_MS=300
LATENCY_MAX_MS=2000
TARGET_URL=http://127.0.0.1:8000
PROXY_PORT=8001

# Client (client/.env)
EXPO_PUBLIC_API_URL=http://127.0.0.1:8000
